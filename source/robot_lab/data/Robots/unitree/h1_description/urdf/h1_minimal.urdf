<?xml version="1.0" encoding="utf-8"?>
<robot name="h1_minimal">
    <!-- h1_minimal: foot + torso collision only (Isaac H1_MINIMAL-style). See h1.urdf for full collision. -->
    <!-- Sensor links (imu/d435/mid360/logo) omitted: Isaac URDF import merges fixed children into torso_link. -->
    <!-- P2: link inertial/mass/COM aligned to Isaac h1_minimal.usd (apply_h1_usd_inertia_to_urdf.py). -->
  <mujoco>
    <compiler meshdir="../meshes" discardvisual="false"/>
  </mujoco>


